PORT=5100
NODE_ENV=development
DATABASE_URL=postgresql://expols:expols_dev@localhost:5432/expols
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
JWT_SECRET=replace_with_a_long_random_secret
