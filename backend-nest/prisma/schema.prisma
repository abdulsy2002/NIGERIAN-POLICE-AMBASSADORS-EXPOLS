generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  fullName        String
  phoneNumber     String?
  role            UserRole         @default(ALUMNI)
  isApproved      Boolean          @default(false)
  stateBaseCode   String?
  stateBaseName   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  alumniProfile   AlumniProfile?
  ambassadorProfile AmbassadorProfile?
  profileUpdateRequests ProfileUpdateRequest[]
  refreshSessions RefreshSession[]
  supportTickets  SupportTicket[]
  @@index([role, createdAt])
  @@index([role, stateBaseCode, createdAt])
}

model ProfileUpdateRequest {
  id               String   @id @default(cuid())
  userId           String
  requestedChanges Json
  status           String   @default("pending")
  processedAt      DateTime?
  processedBy      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, status])
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
}

model AlumniProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  otherName          String?
  gender             String?
  dateOfBirth        String?
  nin                String?
  residentialAddress String?
  passportPhoto      String?
  schoolAttended     String?
  admissionNumber    String?
  yearOfAdmission    Int?
  yearOfGraduation   Int?
  houseHostel        String?
  positionsHeld      String?
  ssceCertificate    String?
  highestQualification String?
  currentOccupation  String?
  stateOfResidence   String?
  alumniMember       String?
  identityNumber     String?  @unique
  isVerified         Boolean  @default(false)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AmbassadorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  gender             String?
  dateOfBirth        String?
  residentialAddress String?
  passportPhoto      String?
  occupation         String?
  organization       String?
  position           String?
  yearsOfExperience  Int?
  linkedinWebsite    String?
  ambassadorType     String?
  supportCommitment  String?
  supportType        String?
  whyAmbassador     String?
  messageToStudents  String?
  supportingDocument String?
  identityNumber     String?  @unique
  isApproved         Boolean  @default(false)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  SUPER_ADMIN
  NATIONAL_ADMIN
  STATE_ADMIN
  ALUMNI
  AMBASSADOR
}

model BoardMember {
  id         String   @id @default(cuid())
  name       String
  role       String
  bio        String
  photoUrl   String
  isFeatured Boolean  @default(false)
  linkedin   String?
  twitter    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ReunionRegistration {
  id              String   @id @default(cuid())
  stateBaseCode   String   @default("NAT")
  fullName        String
  email           String
  phone           String
  school          String
  graduationYear  Int
  attendanceType  String
  paymentStatus   String   @default("pending")
  paymentReference String? @unique
  amountPaid      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([email])
  @@index([stateBaseCode, createdAt])
}

model Payment {
  id                    String   @id @default(cuid())
  stateBaseCode         String   @default("NAT")
  expolIdNumber         String
  fullName              String
  email                 String
  phone                 String
  purpose               String
  customReason         String?
  amount                Int
  currency              String   @default("NGN")
  paystackReference     String   @unique
  paystackTransactionId String?
  status                String   @default("pending")
  paymentDate          DateTime @default(now())
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([email, createdAt])
  @@index([stateBaseCode, createdAt])
}

model PaymentSettings {
  id        String   @id
  purposes  Json
  updatedAt DateTime @updatedAt
}

model ReunionSettings {
  id        String   @id
  settings  Json
  updatedAt DateTime @updatedAt
}

model Broadcast {
  id            String   @id @default(cuid())
  subject       String
  message       String
  sentTo        String
  sentBy        String
  targetBaseCode String?
  targetBaseName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([targetBaseCode, createdAt])
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  stateBaseCode String @default("NAT")
  subject     String
  category    String
  priority    String   @default("medium")
  description String
  status      String   @default("open")
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   SupportTicketResponse[]
  @@index([status, createdAt])
  @@index([stateBaseCode, status, createdAt])
  @@index([stateBaseCode, createdAt])
  @@index([userId, createdAt])
}

model SupportTicketResponse {
  id        String        @id @default(cuid())
  ticketId  String
  adminEmail String
  adminName String
  message   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model GalleryImage {
  id         String   @id @default(cuid())
  stateBaseCode String @default("NAT")
  title      String
  description String?
  imageKey   String
  category   String   @default("General")
  uploadedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([stateBaseCode, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  stateBaseCode String @default("NAT")
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([stateBaseCode, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  action     String
  details    Json?
  createdAt  DateTime @default(now())
  @@index([actorEmail, createdAt])
}
